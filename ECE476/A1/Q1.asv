      'LabelOrientation', 'horizontal')
xline(2*pi*27e9, 'g--', 'K-band end (27 GHz)', 'LineWidth', 1.2, ...
      'LabelHorizontalAlignment', 'left', 'LabelVerticalAlignment', 'middle', ...
      'LabelOrientation', 'horizontal')

xlim([0 2*pi*30e9])
yl = ylim;
text(wc_10/2, yl(2)*0.05, {'Cutoff region', '(no propagation)'}, 'HorizontalAlignment', 'center')

xlabel('\omega (rad/s)')
ylabel('\beta (rad/m)')
title('TE_{10} dispersion')
legend('TE_{10}', 'TEM', 'Location', 'southeast')
hold off